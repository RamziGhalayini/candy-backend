# Environment variable names read by candy-backend. Names only, no values.
# Copy to .env.local (ignored by git) and fill in locally; on Render, set
# them in the service's environment. Line references are to the branch
# hardening/secrets-and-input at 385c54f (2026-10-29).

# Database. Read by app.py:56; falls back to local SQLite when unset.
DATABASE_URL=

# Cloudflare R2 audio-greeting storage. Read by app.py:85-89.
# Retired with the Halloween-era routes; still read on `main` today.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Apple App Store Server API (Legend Mode receipt verification). Required
# four are listed at apple_verification.py:56 and read at :79-86; the
# optional app id at :77; the cert-dir override at :99 (defaults to ./certs).
# Retired with the Halloween-era routes; still read on `main` today.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=
APPLE_APP_APPLE_ID=
APPLE_ROOT_CERT_DIR=

# Legend code hashing pepper. Read by legend_token.py:30.
# Retired with the Halloween-era routes; still read on `main` today.
LEGEND_CODE_PEPPER=

# Set automatically by Render at deploy time, not by a person. Read by
# app.py:795 for the /version endpoint. Leave empty locally.
RENDER_GIT_COMMIT=
